/* TSCC execution profile. Use: nextflow run main.nf -profile tscc */

executor {
    name = 'slurm'
    queueSize = 100
    submitRateLimit = '2 sec'
    perCpuMemAllocation = true
}

process {
    executor = 'slurm'
    queue = 'platinum'
    clusterOptions = '-q hcp-ddp302 -A ddp302'
}

// TSCC data and package locations. Keep these out of main.nf so the default
// pipeline remains portable to local and other HPC installations.
params.hg38_db = '/tscc/projects/ps-lalexandrov/shared/CMPipeline_nextflow/dbs/human-GRC-db.mmi'
params.t2t_phix_db = '/tscc/projects/ps-lalexandrov/shared/CMPipeline_nextflow/dbs/human-GCA-phix-db.mmi'
// Pangenome depletion is OFF by default, and deliberately so: the directory below
// holds 94 HPRC .mmi indexes (643 GB) and mapReads runs minimap2 over every one of
// them, sequentially, per sample -- index loading alone measured 15-18 s and ~11 GB
// RSS per index. Opt in per run:
//   --pangenome_db /tscc/projects/ps-lalexandrov/shared/CMPipeline_nextflow/dbs/pangenome_mmi
// params.pangenome_db = '/tscc/projects/ps-lalexandrov/shared/CMPipeline_nextflow/dbs/pangenome_mmi'
params.kraken_db = '/tscc/projects/ps-lalexandrov/shared/CMPipeline_nextflow/dbs/krakenUniq_8_8_2023'
params.metaphlan_db = '/tscc/projects/ps-lalexandrov/shared/CMPipeline_nextflow/dbs/metaphlan'
// ChocoPhlAn v201901_v31: the MetaPhlAn-4 generation HUMAnN 3.9 needs (audit D05, 2026-09-23). The older
// v296_201901b (MetaPhlAn 3 era) is still in .../humann3/chocophlan/ and is no longer used.
params.humann3_nucleotide_db = '/tscc/lustre/restricted/alexandrov-ddn/users/amabbasi/microbiome/databases/humann3/chocophlan_v201901_v31/'
params.humann3_protein_db = '/tscc/lustre/restricted/alexandrov-ddn/users/amabbasi/microbiome/databases/humann3/uniref/'
