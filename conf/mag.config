/*
 * nf-core/mag configuration for TSCC (SLURM)
 *
 * Runs metagenome assembly + binning on tumor samples using
 * host-depleted reads from CMPipeline MAPPED_READS output.
 *
 * Based on Michael Iter's barnacle2.config adapted for TSCC.
 *
 * Usage:
 *   nextflow run nf-core/mag \
 *     -profile singularity \
 *     -c conf/mag.config \
 *     --input mag_samplesheet.csv \
 *     --outdir RESULTS/MAG \
 *     -resume
 */

// ── Execution (SLURM on TSCC) ─────────────────────────────────────────────
process {
    executor       = 'slurm'
    queue          = 'platinum'
    clusterOptions = '-q hcp-ddp302 -A ddp302'

    // Default resources
    cpus           = 4
    memory         = '32.GB'
    time           = '24.h'

    // Assembly needs more resources
    withName: 'MEGAHIT' {
        cpus   = 16
        memory = '128.GB'
        time   = '48.h'
    }

    // BUSCO quality check
    withName: 'BUSCO' {
        cpus   = 8
        memory = '64.GB'
        time   = '12.h'
    }

    // CheckM2
    withName: 'CHECKM2' {
        cpus   = 8
        memory = '64.GB'
        time   = '24.h'
    }

    // GTDB-Tk
    withName: 'GTDBTK_CLASSIFYWF' {
        cpus   = 16
        memory = '256.GB'
        time   = '48.h'
    }

    // Binning tools need more resources
    withName: 'METABAT2_METABAT2' {
        cpus   = 8
        memory = '64.GB'
        time   = '24.h'
    }
    withName: 'CONCOCT_CONCOCT' {
        cpus   = 8
        memory = '64.GB'
        time   = '24.h'
    }
    withName: 'DASTOOL_DASTOOL' {
        cpus   = 8
        memory = '64.GB'
        time   = '24.h'
    }

    // Error handling:
    //   - Resource failures (OOM, timeout, signals 137/141/143/104/134/139) → retry
    //   - All other failures (empty input, too few contigs, etc.) → ignore
    // Cancer microbiome samples often have very few microbial reads after host
    // depletion, producing empty or sub-500bp assemblies that many downstream
    // processes can't handle. Using 'ignore' as the default lets the pipeline
    // continue with samples that have good assemblies.
    errorStrategy = { task.exitStatus in [141, 143, 137, 104, 134, 139] ? 'retry' : 'ignore' }
    maxRetries    = 3
    maxErrors     = '-1'
}

// ── Singularity ────────────────────────────────────────────────────────────
singularity {
    enabled    = true
    autoMounts = true
    cacheDir   = "/tscc/lustre/restricted/alexandrov-ddn/users/l1joseph/singularity_cache"
}

// ── Resource limits ────────────────────────────────────────────────────────
params {
    max_cpus   = 32
    max_memory = '256.GB'
    max_time   = '72.h'
}

// ── Nextflow executor settings ─────────────────────────────────────────────
executor {
    queueSize       = 50
    submitRateLimit = '10/1min'
}

// ── Timeline / Report ──────────────────────────────────────────────────────
timeline {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/timeline.html"
    overwrite = true
}

report {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/report.html"
    overwrite = true
}
