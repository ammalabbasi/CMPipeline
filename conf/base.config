/*
 * Default resource requests. Ceilings come from `process.resourceLimits` in
 * nextflow.config (driven by params.max_cpus / max_memory / max_time), so these
 * are plain requests -- no check_max() helper, which the Nextflow 25+ config
 * parser rejects.
 */

process {
    cpus   = { 2     * task.attempt }
    memory = { 30.GB * task.attempt }
    time   = { 4.h   * task.attempt }

    errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'finish' }
    maxRetries    = 5
    maxErrors     = '-1'

    // ---------------------------------------------------------------------------
    // Sized from measured peak RSS (2026-09-23, audit C12). Measured on TCGA CRC WGS:
    //   extractReads 25 MB, FASTQC <= 1.2 GB, filterReads 1.2 GB, mapReads 11.1 GB (8.6 GB
    //   minimap2 index), Bracken 77.8 GB (KrakenUniq loads its DB), Decontamination 0.43 GB.
    // Requests sit well above the peak and ALL scale with task.attempt, so a task that needs
    // more gets it on retry. metaphlan4 / humann3 / batch correction keep judgement values;
    // re-measure them from a large run's trace before scale-up (merge_humann3 in particular).
    // ---------------------------------------------------------------------------
    withLabel:process_low {
        cpus   = { 2      * task.attempt }
        memory = {   4.GB * task.attempt }
        time   = {  4.h   * task.attempt }
    }
    withLabel:process_medium {
        cpus   = { 4      * task.attempt }
        memory = {  16.GB * task.attempt }
        time   = { 30.h   * task.attempt }
    }
    withLabel:process_high {
        cpus   = { 16     * task.attempt }
        memory = { 256.GB * task.attempt }
        time   = { 50.h   * task.attempt }
    }
    withLabel:process_high_disk {
        cpus   = { 4      * task.attempt }
        memory = { 128.GB * task.attempt }
        time   = { 50.h   * task.attempt }
        disk   = { 100.GB * task.attempt }
    }
    withLabel: extract_reads {
        cpus   = { 12     * task.attempt }
        memory = {  4.GB  * task.attempt }
        time   = {  8.h   * task.attempt }
    }
    withLabel: fastqc {
        cpus   = { 4      * task.attempt }
        memory = { 4.GB   * task.attempt }
        time   = { 8.h    * task.attempt }
    }
    withLabel: filter_reads {
        cpus   = { 12     * task.attempt }
        memory = {  8.GB  * task.attempt }
        time   = { 10.h   * task.attempt }
    }
    withLabel: mapReads {
        cpus   = { 4     * task.attempt }
        memory = { 24.GB * task.attempt }
        time   = { 50.h  * task.attempt }
    }
    // Per-sample stages (audit C10). --sample_failure_strategy finish (default) keeps today's
    // behaviour: one failed sample stops the run. `ignore` lets the rest of the cohort finish; the
    // failed tasks are listed in the run report and trace. Retryable exit codes still retry first.
    // Cohort reducers (merges, consensus, decontam, batch correction, reports) stay strict.
    // Labels process_long, process_high_memory, error_ignore and error_retry were removed: no
    // process used them (audit C21). tests/test_repo_hygiene.py fails if an unused label returns.
    withLabel: per_sample {
        errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : params.sample_failure_strategy }
    }
}
