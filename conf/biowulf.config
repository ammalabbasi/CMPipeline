/*
 * NIH Biowulf Slurm profile.
 *
 * The default norm partition and conservative scheduler polling follow NIH
 * guidance. Override biowulf_lscratch_gb if a sample needs more local disk.
 */

params.biowulf_lscratch_gb = 200   // also declared in nextflow.config params (audit C21)

executor {
    name = 'slurm'
    queueSize = 200
    pollInterval = '2 min'
    // NIH Biowulf guidance, as cited in Ludmil's pksProfiler audit F17 (audit C12, 2026-09-23)
    queueStatInterval = '5 min'
    submitRateLimit = '6/1min'
}

process {
    executor = 'slurm'
    queue = 'norm'
    clusterOptions = { "--gres=lscratch:${params.biowulf_lscratch_gb}" }
}
