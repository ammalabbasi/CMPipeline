/*
 * antiSMASH configuration for TSCC (SLURM)
 */

process {
    executor       = 'slurm'
    queue          = 'platinum'
    clusterOptions = '-q hcp-ddp302 -A ddp302'

    // Default resources
    cpus           = 8
    memory         = '64.GB'
    time           = '24.h'

    // Ignore failures from empty/tiny assemblies
    errorStrategy  = { task.exitStatus in [141, 143, 137, 104, 134, 139] ? 'retry' : 'ignore' }
    maxRetries     = 3
    maxErrors      = '-1'
}

conda {
    enabled  = true
    useMamba = true
}

executor {
    queueSize       = 50
    submitRateLimit = '10/1min'
}
