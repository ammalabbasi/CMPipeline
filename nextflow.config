/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    {{ name }} Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Default config options for all compute environments
----------------------------------------------------------------------------------------
*/

// Global default params, used in configs
params {

    // params.input (nf-core template leftover) removed: never read; the sample sheet is
    // --sample (audit C21).

    // Max resource options
    max_memory                 = '1.TB'
    max_cpus                   = 64
    max_time                   = '240.h'

    // Where the execution records above are written. Under the launch directory, not
    // the repo, so concurrent runs do not overwrite each other's measurements.
    tracedir                   = "${launchDir}/pipeline_info"

    // Biowulf local scratch per task (GB); read only by conf/biowulf.config.
    biowulf_lscratch_gb        = 200

}

manifest {
    name            = 'AlexandrovLab/CMPipeline'
    author          = 'Alexandrov Lab, University of California San Diego'
    description     = 'Cancer microbiome pipeline: host depletion, taxonomic classification, consensus profiling, decontamination and batch correction'
    mainScript      = 'main.nf'
    // Verified on 24.10.0 and 26.04.6 (2026-09-21): DAG preview, guard behaviour,
    // boolean flags and the completion handlers all behave identically on both.
    // We run 26.04.6. June-young's tree declares '>=25.10.4'; merging his value
    // only tightens this, which is fine.
    nextflowVersion = '>=24.10.0'
}

// Execution records. Without these the pipeline produces no resource measurements at
// all, which is why the label sizings in conf/base.config are guesses rather than
// measurements -- the three trace-*.txt files in the repo are header-only stubs.
// pksProfiler enables the same three, and that is what let its F17 right-size every
// process from an actual run. Written outside the repo, under the launch directory.
report   { enabled = true; overwrite = true; file = "${params.tracedir}/report.html"   }
timeline { enabled = true; overwrite = true; file = "${params.tracedir}/timeline.html" }
trace    { enabled = true; overwrite = true; file = "${params.tracedir}/trace.txt"     }
// Nextflow's default trace columns plus attempt, cpus, memory and workdir (audit K07). workdir is
// how scripts/finalize_provenance.py finds each task's runtime tool-version record
// (<work dir>/.tool_versions.tsv, lib/ToolVersions.groovy) -- cached tasks included -- without a
// walk of the work tree; attempt and cpus say which retry and how many threads produced a table.
trace.fields = 'task_id,hash,native_id,name,status,exit,submit,duration,realtime,%cpu,peak_rss,peak_vmem,rchar,wchar,attempt,cpus,memory,workdir'
dag      { enabled = true; overwrite = true; file = "${params.tracedir}/dag.html"      }

// Load base.config by default for all pipelines
includeConfig 'conf/base.config'

// Configure the stage-out directive
workDir = './work'

// Define the environment settings
conda.enabled = true

// Keep built environments out of the work directory. Nextflow otherwise defaults
// this to <work-dir>/conda, so every differently named run -- and every run whose
// work directory was cleaned up -- rebuilds all of conda_envs/ from scratch.
// Override with NXF_CONDA_CACHEDIR or in a site profile.
conda.cacheDir = System.getenv('NXF_CONDA_CACHEDIR') ?: "${projectDir}/.conda_cache"

// Building an env from its lockfile on Lustre can take well over Nextflow's 20-minute default:
// the consensus env (182 packages) was killed mid-install on 2026-09-23 and left a half-built
// prefix that later runs would reuse. 2 h covers the largest env (HUMAnN, 552 packages).
conda.createTimeout = '2 h'

// Portable default: run locally. Site-specific executors belong in profiles.
executor {
    name = 'local'
}

profiles {
    tscc {
        includeConfig 'conf/tscc.config'
    }
    slurm {
        includeConfig 'conf/slurm.config'
    }
    pbs {
        includeConfig 'conf/pbs.config'
    }
    lsf {
        includeConfig 'conf/lsf.config'
    }
    biowulf {
        includeConfig 'conf/biowulf.config'
    }
    sge {
        includeConfig 'conf/sge.config'
    }
    conda {
        conda.enabled          = true
        docker.enabled         = false
        singularity.enabled    = false
        podman.enabled         = false
        shifter.enabled        = false
        charliecloud.enabled   = false
    }
    mamba {
        conda.enabled          = true
        conda.useMamba         = true
        docker.enabled         = false
        singularity.enabled    = false
        podman.enabled         = false
        shifter.enabled        = false
        charliecloud.enabled   = false
    }
    // docker/singularity/podman/shifter/charliecloud profiles removed (audit D12, 2026-09-23): no
    // process declares a `container`, so they ran every tool with no environment at all. The
    // supported route is conda from the lockfiles in conda_envs/lock/ (the default).
    arm {
        docker.runOptions = '-u $(id -u):$(id -g) --platform=linux/amd64'
    }
    gitpod {
        executor.name          = 'local'
        executor.cpus          = 16
        executor.memory        = 60.GB
    }
    local {
        // The executor caps are kept deliberately (MERGE_CHECKLIST 4.3). June-young's
        // tree drops them. process.resourceLimits bounds each individual task, but only
        // executor.cpus/memory bounds total concurrency -- which is what stops a local
        // run from swamping a shared login node.
        executor.name          = 'local'
        process.executor       = 'local'
        executor.cpus          = 8
        executor.memory        = 32.GB
        // Per-task ceilings to match (audit C12): labels such as process_high (16 CPU / 256 GB)
        // could never be scheduled by an 8 CPU / 32 GB local executor.
        // Set through the params the top-level process.resourceLimits reads, since that block
        // comes later in this file and would override a profile-level resourceLimits.
        params.max_cpus        = 8
        params.max_memory      = '32.GB'
    }
    //test      { includeConfig 'conf/test.config'      }
    //test_full { includeConfig 'conf/test_full.config' }
}

// Resource ceilings. `process.resourceLimits` is the supported mechanism as of
// Nextflow 24.04; the old check_max() helper was a top-level function in this file,
// which the strict config parser in Nextflow 25+ rejects outright with
// "Unexpected input: '('". Keeping it would pin the pipeline to Nextflow 24.x.
process {
    resourceLimits = [
        cpus:   params.max_cpus as int,
        memory: params.max_memory as nextflow.util.MemoryUnit,
        time:   params.max_time as nextflow.util.Duration
    ]
}

// Make each task's conda environment win (audit K06/X04; pksProfiler 26e196d). Two parts, both run
// by beforeScript, which Nextflow places in .command.run just BEFORE the conda activation line:
//
// 1. PATH. Nextflow activates a task's env with `source <base>/bin/activate <env>`, and activation
//    swaps the base bin entry for the env's IN PLACE. Anything the launching shell had ahead of the
//    conda base on PATH -- and SLURM plus Nextflow copy the launching PATH into every task -- still
//    shadows the env. That is how CRC50 attempt 1 (Job 12380606) ran ~/.bashrc's tools/minimap2 2.24
//    in all 50 mapReads tasks instead of the pinned 2.28, with nf-env/bin's samtools, bgzip,
//    krakenuniq, bracken and python ahead of the envs too. Putting `conda info --base`/bin first
//    before activation puts the env's bin first after it. A no-op when conda is not on PATH. Tools
//    the env does not ship still resolve along the rest of PATH; the tool-version record
//    (lib/ToolVersions.groovy) checks every tool a process runs and stops the run (exit 78) if one
//    resolves outside the env.
//
// 2. Library and interpreter search paths, unset rather than set to '': ~/.bashrc on TSCC exports
//    LD_LIBRARY_PATH (ascat, qiime2, boost libs), LIBRARY_PATH, CPATH and PYTHONPATH, and SLURM
//    exports them into each task. A leaked LD_LIBRARY_PATH broke the host python's hashlib
//    (`libcrypto.so.3: version OPENSSL_3.4.0 not found`, Job 12403679). Safe to drop in a task:
//    conda binaries find their libraries through RPATH ($ORIGIN/../lib), R sets its own library
//    path from R_HOME/etc/ldpaths, and no task compiles anything (CPATH/LIBRARY_PATH only steer
//    compilers; an EMPTY CPATH can even mean "the current directory" to gcc, hence unset, not '').
//    PYTHONHOME would point every env's python at another prefix's stdlib; PERL5LIB would put a
//    user's Perl modules ahead of the env's for krakenuniq/bracken; R_LIBS / R_LIBS_USER /
//    R_LIBS_SITE would put a user's R library ahead of the env's for decontam (BatchCorrection sets
//    all three to the env's own library itself). conda's activate.d scripts run AFTER this and may
//    set what their package needs.
//
// PYTHONNOUSERSITE / PYTHONPATH stay in the env scope below (exported after activation).
// tests/integration/integration.config repeats this string for Bracken (a withName beforeScript
// replaces this one); tests/test_tool_versions.py keeps the two identical.
process.beforeScript = 'unset LD_LIBRARY_PATH LIBRARY_PATH CPATH PYTHONHOME PERL5LIB R_LIBS R_LIBS_USER R_LIBS_SITE; if command -v conda >/dev/null 2>&1; then export PATH="$(conda info --base)/bin:$PATH"; fi'

// Keep every task inside its own conda env (audit D13, 2026-09-23). Python puts the user
// site-packages (~/.local/lib/pythonX.Y) AHEAD of an env's own packages, and SLURM exports the
// launching shell's PYTHONPATH into each task, so a task could silently import the launching
// user's personal pandas/numpy/scipy instead of the locked ones. Found when the HUMAnN env's
// metaphlan picked up a broken ~/.local pandas. R has no equivalent here: no user R library.
env {
    PYTHONNOUSERSITE = '1'
    PYTHONPATH       = ''
}
