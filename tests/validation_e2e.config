// Config for tests/validation_e2e.nf: local executor inside one SLURM job, conda envs cached
// alongside the pipeline's own (same cacheDir as nextflow.config).
conda.enabled  = true
conda.cacheDir = System.getenv('NXF_CONDA_CACHEDIR') ?: "${projectDir}/../.conda_cache"
executor {
    name   = 'local'
    cpus   = 16
    memory = '100 GB'
}
process {
    withName: 'buildValidationRef' { cpus = 8;  memory = '40 GB'; time = '4h' }
    withName: 'alignForValidation' { cpus = 8;  memory = '40 GB'; time = '4h' }
    withLabel: 'process_low'       { cpus = 1;  memory = '4 GB';  time = '1h' }
}
