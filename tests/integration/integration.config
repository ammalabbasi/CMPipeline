// Executed integration test (audit C22): layered on nextflow.config with -c by run_integration.sh.
// Local executor, one CPU per task, the pipeline's own conda envs from the shared cacheDir
// (nextflow.config; NXF_CONDA_CACHEDIR still wins). Every database the run sees is synthetic
// (make_fixtures.py); the only stand-in is KrakenUniq, replaced by tests/integration/stub_krakenuniq.py.
executor {
    name = 'local'
}
process {
    executor       = 'local'
    // Caps every label (extract_reads asks for 12 CPUs, Bracken 128 GB) to what a login-sized
    // allocation has; the synthetic inputs are a few hundred reads.
    resourceLimits = [cpus: 1, memory: 4.GB, time: 1.h]
    maxRetries     = 0
    // KrakenUniq has no toy database. The stub is injected as an EXPORTED SHELL FUNCTION rather
    // than on PATH: beforeScript runs before `conda activate`, which would put the env's own
    // krakenuniq first on PATH, but a function outranks any PATH lookup in .command.sh.
    // Bracken, kreport2mpa and the MetaPhlAn gate all run for real on the stub's report.
    withName: 'Bracken' {
        beforeScript = "krakenuniq() { python3 '${projectDir}/tests/integration/stub_krakenuniq.py' \"\$@\"; }; export -f krakenuniq"
    }
}
