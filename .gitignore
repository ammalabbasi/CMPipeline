*.launcher.log

# Conda environment cache (conda.cacheDir)
.conda_cache/

# macOS AppleDouble resource forks (arrive with files synced from a Mac)
._*
.DS_Store

# Alignment-validation reference cache (downloaded public genomes + .mmi; params.validation_cache_dir)
.validation_cache/
.pytest_cache/
